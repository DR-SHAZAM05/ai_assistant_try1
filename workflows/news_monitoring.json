{
  "name": "Periodic RSS News Refresh",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "name": "Refresh Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "http://app:8000/api/v1/automation/news/refresh",
        "jsonParameters": true,
        "headerParametersUi": {
          "parameter": [
            {
              "name": "x-automation-key",
              "value": "={{ $env.AUTOMATION_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Refresh RSS Sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Refresh Every 6 Hours": {
      "main": [
        [
          {
            "node": "Refresh RSS Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
