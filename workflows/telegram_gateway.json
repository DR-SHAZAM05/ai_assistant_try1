{
  "name": "Telegram Webhook Gateway",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-webhook",
        "responseMode": "responseNode"
      },
      "name": "Telegram Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "http://app:8000/api/v1/telegram/webhook",
        "jsonParameters": true,
        "bodyParametersJson": "={{ JSON.stringify($json.body) }}",
        "headerParametersUi": {
          "parameter": [
            {
              "name": "x-telegram-bot-api-secret-token",
              "value": "={{ $json.headers['x-telegram-bot-api-secret-token'] }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Forward Verified Telegram Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "name": "Respond to Telegram",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [750, 300]
    }
  ],
  "connections": {
    "Telegram Webhook": {
      "main": [
        [
          {
            "node": "Forward Verified Telegram Update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward Verified Telegram Update": {
      "main": [
        [
          {
            "node": "Respond to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
