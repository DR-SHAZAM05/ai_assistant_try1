# Copy this file to .env. Do not commit .env or OAuth credential/token files.
# Development uses explicit mock fallbacks only while ALLOW_MOCK_PROVIDERS=true.

APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-long-random-secret-before-production
HOST=0.0.0.0
PORT=8000
CURRENT_ACADEMIC_YEAR=2026-2027
ALLOW_MOCK_PROVIDERS=true
# Required in production, comma separated. Example: https://assistant.example.edu
CORS_ALLOWED_ORIGINS=

# PostgreSQL. DATABASE_URL is optional; Settings builds it from values below when omitted.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=academic_assistant_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_CONNECT_TIMEOUT_SECONDS=2
POSTGRES_DOCKER_CONTAINER=academic_ai_postgres
SQL_ECHO=false
# DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-strong-postgres-password@localhost:5432/academic_assistant_db

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=practice_knowledge
QDRANT_API_KEY=

# LLM and embeddings: openai | ollama. "mock" is accepted only outside production.
LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=<PLACEHOLDER_OPENAI_API_KEY>
OPENAI_BASE_URL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VECTOR_SIZE=1536
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_REQUEST_TIMEOUT_SECONDS=120.0

# Practice RAG
KNOWLEDGE_BASE_DIR=knowledge_base
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35

# Telegram. TELEGRAM_WEBHOOK_URL must be public HTTPS for a real deployment.
TELEGRAM_BOT_TOKEN=<PLACEHOLDER_TELEGRAM_BOT_TOKEN>
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ALLOWED_USER_IDS=

# Personal mailbox: use an application password, not your account password.
EMAIL_PROVIDER=imap
EMAIL_ACCOUNT=
EMAIL_PASSWORD=
EMAIL_IMAP_SERVER=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_FOLDER=INBOX
EMAIL_IMAP_USE_SSL=true
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_STARTTLS=true

# UNITBV mailbox
UNITBV_EMAIL_PROVIDER=imap
UNITBV_EMAIL_ACCOUNT=
UNITBV_EMAIL_PASSWORD=
UNITBV_EMAIL_IMAP_SERVER=outlook.office365.com
UNITBV_EMAIL_IMAP_PORT=993
UNITBV_EMAIL_IMAP_FOLDER=INBOX
UNITBV_EMAIL_IMAP_USE_SSL=true
UNITBV_EMAIL_SMTP_SERVER=smtp.office365.com
UNITBV_EMAIL_SMTP_PORT=587
UNITBV_EMAIL_SMTP_USE_STARTTLS=true

# Google Calendar: authorize OAuth with scripts/authorize_google_calendar.py,
# or use a service-account JSON file shared with GOOGLE_CALENDAR_ID.
CALENDAR_PROVIDER=google
GOOGLE_AUTH_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_TOKEN_FILE=secrets/google-calendar-token.json
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
GOOGLE_CALENDAR_TIMEZONE=Europe/Bucharest

# News and automation
NEWS_CONFIG_FILE=config/news.example.yaml
NEWS_MAX_RESULTS=5
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook
# Required before enabling the imported n8n polling workflows.
AUTOMATION_API_KEY=

# Human approval and external request hardening
REQUIRE_HUMAN_APPROVAL_FOR_EMAILS=true
REQUIRE_HUMAN_APPROVAL_FOR_CALENDAR_MODS=true
DRAFT_APPROVAL_TTL_SECONDS=900
EXTERNAL_RETRY_ATTEMPTS=2
EXTERNAL_REQUEST_TIMEOUT_SECONDS=20
AUDIT_LOG_ENABLED=true
AUDIT_LOG_STORE_REQUEST_CONTENT=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
TELEGRAM_RATE_LIMIT_REQUESTS=30
RATE_LIMIT_MAX_TRACKED_KEYS=10000
