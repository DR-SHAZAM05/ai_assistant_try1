{
  "name": "UNITBV - Daily News RSS Refresh",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger-news",
      "name": "Every Morning at 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://academic_ai_app:8000/api/v1/automation/news/refresh",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "http-request-news",
      "name": "Trigger News Ingestion & Scoring",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "63hixaKgI38jNYz5",
          "name": "Academic AI Automation Header"
        }
      }
    }
  ],
  "connections": {
    "Every Morning at 08:00": {
      "main": [
        [
          {
            "node": "Trigger News Ingestion & Scoring",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Bucharest",
    "saveExecutionProgress": true
  }
}
